# Model provider: vllm (local NVIDIA/vLLM on this DGX) or openai.
DEEPAGENTS_MODEL_PROVIDER=vllm

# ---------------------------------------------------------------------------
# vLLM — local OpenAI-compatible server (default on this machine)
# Start with:  ~/Desktop/start-vllm.sh
#           or ~/Desktop/serve-local-llm.sh up coder-next
# Catalog:     curl http://127.0.0.1:8000/v1/models
# ---------------------------------------------------------------------------
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Must match an id from GET ${VLLM_BASE_URL}/models (or ./ralphdgx test vllm).
VLLM_MODEL=Qwen/Qwen3-Coder-Next-FP8
# vLLM usually ignores auth; ChatOpenAI still needs a non-empty key.
VLLM_API_KEY=test
# Qwen3-Coder-Next-FP8 on this host advertises 131072 max context.
VLLM_MAX_INPUT_TOKENS=131072
# Per-chunk streaming gap timeout (seconds) for langchain-openai. Large local
# models can pause longer than the 120s default between chunks. Leave UNSET to
# use the vllm path default (600). Set 0 to disable.
# LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=600

# ---------------------------------------------------------------------------
# OpenAI — real api.openai.com, or any OpenAI-compatible endpoint via BASE_URL
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_INPUT_TOKENS=128000

DEEPAGENTS_CODE_GOAL_JUDGE_TAIL=8
DEEPAGENTS_CODE_GOAL_JUDGE_MESSAGE_CHARS=600
DEEPAGENTS_CODE_DISABLE_SYNC_SUBAGENTS=true
RALPH_UPDATE_GOAL_BUDGET=12
RALPH_UPDATE_NO_MCP=true

DEEPAGENT_REASONING_EFFORT=xhigh
DEEPAGENT_APPROVE_SHELL=true
DEEPAGENT_APPROVE_WRITES=true
DEEPAGENTS_CODE_NO_UPDATE_CHECK=1
DEEPAGENTS_CODE_LANGSMITH_TRACING=false
DEEPAGENTS_CODE_LANGCHAIN_TRACING_V2=false

GOAL_MODE=false
GOAL_BUDGET=20
GOAL_JUDGE_MODEL=
